# ---------------- Server ----------------
PORT=4000
NODE_ENV=development

# The React app's address (needed so the browser is allowed to call this API)
CLIENT_ORIGIN=http://localhost:5173

# This server's own public address — used to build image URLs
PUBLIC_URL=http://localhost:4000

# ---------------- MySQL ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=obd_lighting

# ---------------- Admin login ----------------
# Change this to a long random string before going live.
# Anyone who knows it can sign themselves in as admin.
JWT_SECRET=change-me-to-a-long-random-string-before-going-live
JWT_EXPIRES_IN=7d
