# ---------------- Server ----------------
PORT=4000
NODE_ENV=development

# The site's address, so the browser is allowed to call this API.
# Several are allowed, separated by commas:
#   CLIENT_ORIGIN=https://obdlighting.com,https://www.obdlighting.com
CLIENT_ORIGIN=http://localhost:5173

# This server's own public address — used to build image URLs
PUBLIC_URL=http://localhost:4000

# ---------------- Database ----------------
# Local (XAMPP / Laragon):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=obd_lighting

# TiDB Cloud Serverless — copy these from Cluster -> Connect:
#   DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
#   DB_PORT=4000
#   DB_USER=xxxxxxxx.root
#   DB_PASSWORD=<the password TiDB generated>
#   DB_NAME=obd_lighting
# TLS switches itself on for any tidbcloud.com host. Force it either way with:
# DB_SSL=true

# ---------------- Admin login ----------------
# Anyone who knows this can sign themselves in as admin.
# At least 32 random characters — in production the server refuses to start
# without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-before-going-live
JWT_EXPIRES_IN=7d
